# Required: use a development tenant's ID or verified domain, not "common".
TENANT_ID=your-tenant-id-or-verified-domain

# Give this rehearsal a unique name. Use letters, numbers, dots, dashes or underscores.
AGENT_PREFIX=obo-demo

# Microsoft Graph Command Line Tools. Your organization can supply an approved
# public-client registration instead; see the README permission table.
BOOTSTRAP_CLIENT_ID=14d82eec-204b-4c2f-b7e8-296a70dab67e

# device_code or interactive. Interactive uses a localhost browser callback.
# Use a mode allowed by your tenant; do not disable Conditional Access.
AUTH_MODE=device_code

# Optional: object ID of a different MEMBER user in this tenant.
# Blank means use the provisioning administrator again for the user sign-in.
# Graph consent is restricted to this one user, not the whole tenant.
DEMO_USER_OBJECT_ID=

# Optional absolute path. The default is OUTSIDE this repository:
# %LOCALAPPDATA%\EntraOboDemo\<tenant-id>-<prefix>.json on Windows.
# This development-only file contains the blueprint client secret in plaintext.
# Do not put it in OneDrive, a shared folder, or source control.
AGENT_STATE_FILE=
